Version 4
SHEET 1 1440 1024
TEXT 64 16 Left 2 ;Differential crossbar: output = positive current - negative current
TEXT 64 48 Left 2 ;One row input per voltage source; two grounded sense sources per output
TEXT 64 80 Left 2 ;Input voltages
TEXT 300 80 Left 2 ;Conductance paths (P = positive, N = negative)
SYMBOL voltage 96 144 R0
SYMATTR InstName V1
SYMATTR Value 5
FLAG 96 160 row1
FLAG 96 240 0
SYMBOL voltage 96 320 R0
SYMATTR InstName V2
SYMATTR Value 6
FLAG 96 336 row2
FLAG 96 416 0
SYMBOL res 320 144 R0
SYMATTR InstName R1_1P
SYMATTR Value 10000
FLAG 336 160 row1
FLAG 336 240 col1_pos
SYMBOL res 880 144 R0
SYMATTR InstName R1_2N
SYMATTR Value 5000
FLAG 896 160 row1
FLAG 896 240 col2_neg
SYMBOL res 480 320 R0
SYMATTR InstName R2_1N
SYMATTR Value 3333.33333333
FLAG 496 336 row2
FLAG 496 416 col1_neg
SYMBOL res 720 320 R0
SYMATTR InstName R2_2P
SYMATTR Value 2500
FLAG 736 336 row2
FLAG 736 416 col2_pos
TEXT 1176 80 Left 2 ;Output current sensors
SYMBOL voltage 1176 144 R0
SYMATTR InstName VSENSE1P
SYMATTR Value 0
FLAG 1176 160 col1_pos
FLAG 1176 240 0
SYMBOL voltage 1376 144 R0
SYMATTR InstName VSENSE1N
SYMATTR Value 0
FLAG 1376 160 col1_neg
FLAG 1376 240 0
SYMBOL voltage 1176 496 R0
SYMATTR InstName VSENSE2P
SYMATTR Value 0
FLAG 1176 512 col2_pos
FLAG 1176 592 0
SYMBOL voltage 1376 496 R0
SYMATTR InstName VSENSE2N
SYMATTR Value 0
FLAG 1376 512 col2_neg
FLAG 1376 592 0
TEXT 64 1024 Left 2 !.op
TEXT 64 1072 Left 2 ;With input V = vector values in volts, y = Rbase * (Ipositive - Inegative)
TEXT 64 1120 Left 2 !.meas OP Y1 PARAM 10000*(I(VSENSE1P)-I(VSENSE1N))
TEXT 64 1152 Left 2 !.meas OP Y2 PARAM 10000*(I(VSENSE2P)-I(VSENSE2N))
